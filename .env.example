# Copy to .env (git-ignored) and adjust. Nothing here is a secret by default.

# Local proxy that WeChat for Linux should point at
WXCLIP_PROXY_HOST=127.0.0.1
WXCLIP_PROXY_PORT=8899

# Admin / download dashboard
WXCLIP_SERVER_HOST=127.0.0.1
WXCLIP_SERVER_PORT=8080

# Where downloads land (git-ignored)
WXCLIP_DOWNLOAD_DIR=./downloads

# Traffic logs, captured JSAPI payloads and saved pages (git-ignored)
WXCLIP_CAPTURE_DIR=./captures

# Proxy CA. Outside the repo on purpose - it holds a private key
WXCLIP_CA_DIR=~/.config/wxclip/ca

# Stills, transcript and summary, one subdirectory per clip (git-ignored, disposable)
WXCLIP_PROCESS_DIR=./processed

# Optional: credentials for the summarize step (M3). Either one works - the API key
# wins if both are set. Put the real value in .env, never here.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
